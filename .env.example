# Copia este archivo como .env.local y rellena los valores.
# Supabase → Project Settings → API (o "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "publishable key" (sb_publishable_...) o la "anon key" antigua. Es pública por diseño: la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Número de WhatsApp del negocio, solo dígitos con código de país (51 = Perú). Este es de prueba.
NEXT_PUBLIC_WHATSAPP_NUMBER=51900000000
